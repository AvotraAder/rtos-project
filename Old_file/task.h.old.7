#ifndef TASK_H
#define TASK_H

#include <stdint.h>

typedef struct task {
    uint32_t esp;            /* Pointeur de pile sauvegardé */
    uint32_t id;             /* Identifiant de la tâche */
    uint8_t stack[4096];     /* Pile dédiée de 4 Ko par tâche */
    struct task* next;       /* Prochaine tâche dans la file */
} task_t;

void init_tasking(void);
void create_task(void (*entry)(void));
uint32_t schedule(uint32_t current_esp);

#endif
