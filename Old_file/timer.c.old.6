#include "timer.h"
#include "idt.h"

static uint32_t tick = 0;

static inline void outb(uint16_t port, uint8_t val) {
    __asm__ __volatile__ ("outb %0, %1" : : "a"(val), "Nd"(port));
}

/* Callback déclenché à chaque IRQ0 */
static void timer_callback(registers_t* regs) {
    (void)regs;
    tick++;
}

uint32_t get_ticks(void) {
    return tick;
}

void init_timer(uint32_t frequency) {
    /* Enregistre notre callback pour l'IRQ0 (Interruption 32) */
    register_interrupt_handler(32, timer_callback);

    /* Calcul du diviseur */
    uint32_t divisor = 1193180 / frequency;

    /* Configuration du PIT : Canal 0, accès octet bas/haut, mode onde carrée (0x36) */
    outb(0x43, 0x36);

    /* Envoi du diviseur (poids faible puis poids fort) */
    outb(0x40, (uint8_t)(divisor & 0xFF));
    outb(0x40, (uint8_t)((divisor >> 8) & 0xFF));
}
