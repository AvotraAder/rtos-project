#include "task.h"

static task_t main_task;
static task_t* current_task = &main_task;
static uint32_t next_pid = 1;

void init_tasking(void) {
    main_task.id = 0;
    main_task.esp = 0;
    main_task.next = &main_task;
    current_task = &main_task;
}

void create_task(void (*entry)(void)) {
    static task_t task_pool[5];
    static int pool_index = 0;

    task_t* new_task = &task_pool[pool_index++];
    new_task->id = next_pid++;

    /* Pointeur vers le haut de la pile (la pile descend) */
    uint32_t* stack_ptr = (uint32_t*)(new_task->stack + 4096);

    /* Context frame attendu lors d'un retour d'interruption (iret / popa) */
    *(--stack_ptr) = 0x0202;          /* EFLAGS (Interrupts actives) */
    *(--stack_ptr) = 0x08;            /* CS (Segment de Code) */
    *(--stack_ptr) = (uint32_t)entry; /* EIP (Adresse d'entrée de la tâche) */

    *(--stack_ptr) = 0;               /* Code d'erreur factice */
    *(--stack_ptr) = 32;              /* Numéro d'interruption */

    /* Registres généraux (pusha) : EAX, ECX, EDX, EBX, ESP, EBP, ESI, EDI */
    for (int i = 0; i < 8; i++) {
        *(--stack_ptr) = 0;
    }

    *(--stack_ptr) = 0x10;            /* DS (Segment de Données) */

    new_task->esp = (uint32_t)stack_ptr;

    /* Insertion en liste circulaire (Round-Robin) */
    new_task->next = current_task->next;
    current_task->next = new_task;
}

uint32_t schedule(uint32_t current_esp) {
    if (!current_task) return current_esp;

    /* Sauvegarde le pointeur de pile de la tâche courante */
    current_task->esp = current_esp;

    /* Passe à la tâche suivante */
    current_task = current_task->next;

    /* Renvoie le pointeur de pile de la nouvelle tâche */
    return current_task->esp;
}
