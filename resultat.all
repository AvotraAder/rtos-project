section .text

isr_common_stub:
 pusha
 mov ax, ds
 push eax
 mov ax, 0x10
 mov ds, ax
 mov es, ax
 mov fs, ax
 mov gs, ax
 call isr_handler
 pop eax
 mov ds, ax
 mov es, ax
 mov fs, ax
 mov gs, ax
 popa
 add esp, 8
 sti
 iret

irq_common_stub:
 pusha
 mov ax, ds
 push eax
 mov ax, 0x10
 mov ds, ax
 mov es, ax
 mov fs, ax
 mov gs, ax
 push esp
 call irq_handler
 mov esp, eax
 pop eax
 mov ds, ax
 mov es, ax
 mov fs, ax
 mov gs, ax
 popa
 add esp, 8
 sti
 iret

isr128:
 cli
 push edx ; arg3
 push ecx ; arg2
 push ebx ; arg1
 push eax ; sys_num
 call syscall_handler
 add esp, 16
 sti
 iret

