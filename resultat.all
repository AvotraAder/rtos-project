global isr_common_stub
global irq_common_stub
global isr128

extern isr_handler
extern irq_handler
extern syscall_handler

%macro ISR_NOERRCODE 1
global isr%1
isr%1:
 cli
 push dword 0
 push dword %1
 jmp isr_common_stub
%endmacro

%macro ISR_ERRCODE 1
global isr%1
isr%1:
 cli
 push dword %1
 jmp isr_common_stub
%endmacro

%macro IRQ 2
global irq%1
irq%1:
 cli
 push dword 0
 push dword %2
 jmp irq_common_stub
%endmacro

