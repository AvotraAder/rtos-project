#ifndef TASK_H
#define TASK_H

#include <stdint.h>

typedef enum {
    TASK_READY,
    TASK_SLEEPING
} task_state_t;

typedef struct task {
    uint32_t esp;            /* Pointeur de pile sauvegardé */
    uint32_t id;             /* Identifiant de la tâche */
    task_state_t state;      /* État courant de la tâche */
    uint32_t sleep_ticks;    /* Ticks restants avant réveil */
    uint8_t stack[4096];     /* Pile dédiée de 4 Ko */
    struct task* next;       /* Prochaine tâche dans la file */
} task_t;

void init_tasking(void);
void create_task(void (*entry)(void));
uint32_t schedule(uint32_t current_esp);
void task_sleep(uint32_t ticks);
task_t* get_current_task(void);

#endif
